#!/usr/bin/env bash
# Sets up the demo: unpin → pin → poison the imposter-commit workflow.
#
# Usage: script/infect

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

PRE_ATTACK_SHA="ea53476fdc172d8552df5af9658a45a367e4f41d"

echo "① Stripping existing dependencies…"
script/unpin

echo ""
echo "② Pinning all workflows…"
gh actions-pin .github/workflows/*.yml

echo ""
echo "③ Poisoning imposter-commit workflow…"

current_sha=$(grep "nested-composite@tampered:sha1-" .github/workflows/imposter-commit.yml | head -1 | sed "s/.*sha1-//" | tr -d '[:space:]')
if [ -z "$current_sha" ]; then
  echo "   SKIP: no pinned entry for @tampered" >&2
  exit 1
fi
sed -i '' "s|nested-composite@tampered:sha1-${current_sha}|nested-composite@tampered:sha1-${PRE_ATTACK_SHA}|" .github/workflows/imposter-commit.yml
echo "   infected: imposter-commit.yml — ${current_sha:0:12} → ${PRE_ATTACK_SHA:0:12}"
